# =========================================================================
# QoR Recorder 环境变量配置示例 (v5.0)
# 复制为 .env 后取消注释相应行, 修改实际值
# 部署详细步骤见 deploy/README.md, 数据格式见 docs/DATA_FORMAT.md
# =========================================================================

# -----------------------------------------------------------------------------
# 数据库后端 (DB_TYPE): 一个变量切换 sqlite / sql / mongodb
#   sqlite   (默认) - 本地文件, 按项目分库 (qor_p_<id>.db), WAL 模式, 零运维
#                     适合单人或小团队 (< 20 人, < 10 万记录)
#   sql      - MySQL / MariaDB / PostgreSQL, 适合多项目大规模团队 (20+ 人)
#   mongodb  - MongoDB, 文档数据库, 主库 SQLite + 业务库 Mongo dual-write
# -----------------------------------------------------------------------------
DB_TYPE=sqlite
# Heavy-data repository: orm / mongo / hybrid. Reviews/config always use SQL.
# Docker Compose defaults to hybrid so Mongo is primary with ORM fallback.
PERSISTENCE_MODE=hybrid

# -----------------------------------------------------------------------------
# 当 DB_TYPE=sql 时必填 (MySQL/PostgreSQL 连接字符串)
# -----------------------------------------------------------------------------
# MySQL 示例:
#   DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/qor_recorder?charset=utf8mb4
#
# PostgreSQL 示例:
#   DATABASE_URL=postgresql+psycopg2://postgres:yourpassword@localhost:5432/qor_recorder
#
# 也支持简写 (自动转换):
#   mysql://user:pass@host:3306/db   -> mysql+pymysql://user:pass@host:3306/db
#   postgres://user:pass@host:5432/db -> postgresql+psycopg2://user:pass@host:5432/db
#DATABASE_URL=

# -----------------------------------------------------------------------------
# 当 DB_TYPE=mongodb 时必填 (MongoDB 连接)
# -----------------------------------------------------------------------------
# Compose service name is "mongo"; use localhost for a host-installed mongod.
# MONGODB_URI=mongodb://mongo:27017
# MONGODB_DB=qor_recorder
# MONGODB_DATA_DIR=./mongodbdir
# MONGODB_TIMEOUT_MS=2000

# Runtime paths. Compose overrides these with container paths and bind mounts.
# DATA_DIR=./data
# UPLOAD_FOLDER=./uploads
# BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# Django 安全 (生产环境必须修改, 否则启动失败)
# -----------------------------------------------------------------------------
# SECRET_KEY=please-set-a-long-random-string-here    # 必填, openssl rand -hex 32
# ALLOWED_HOSTS=qor.example.internal,localhost
# CSRF_TRUSTED_ORIGINS=https://qor.example.internal  # include scheme, comma-separated
# SESSION_COOKIE_SECURE=1                            # HTTPS 后必开
# SECURE_SSL_REDIRECT=1                              # TLS 入口未负责跳转时启用
# SECURE_HSTS_SECONDS=31536000                       # 确认全站 HTTPS 后再启用
# SECURE_HSTS_INCLUDE_SUBDOMAINS=0
# SECURE_HSTS_PRELOAD=0
# ENFORCE_SECRET_KEY=1                               # DEBUG=0 时强制检查 SECRET_KEY
# SESSION_LIFETIME_HOURS=12                          # Session 有效期
# Browser writes must send the csrftoken cookie value as X-CSRFToken.
# Nginx supplies X-Forwarded-Proto; do not expose Gunicorn directly.

# Vue is the production UI. "legacy" records a rollback choice for direct/
# systemd deployments; Docker Nginx always keeps /legacy/dashboard/ available.
FRONTEND_MODE=vue
FRONTEND_URL=/

# -----------------------------------------------------------------------------
# 监听地址 (生产建议 127.0.0.1 + Nginx 反代, 不要直接暴露 5000)
# -----------------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
# DEBUG=0
# HTTP_PORT=80
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120

# -----------------------------------------------------------------------------
# 数据库可视化 (内置 Adminer, 仅 sql/sqlite 模式可用)
# -----------------------------------------------------------------------------
# ENABLE_DB_ADMIN=0
# DB_ADMIN_SERVER=localhost
# DB_ADMIN_NAME=qor_recorder

# -----------------------------------------------------------------------------
# v5.0 默认账户 (生产环境必须修改默认密码, 强制改密机制)
# -----------------------------------------------------------------------------
# admin   / admin@2026   - admin  (全功能)
# release / release@2026  - owner  (历史 release, 已自动迁移为 owner)
# viewer  / viewer@2026   - viewer (v5.0 新增, 只读, 仅看已发布数据)
# 注: 三个默认账户首次登录后强制跳转到 /change_password, 改密前写操作 403

