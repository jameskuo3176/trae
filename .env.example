# QoR Recorder 环境变量配置示例
#
# 使用方法:
#   1. 复制此文件为 .env (cp .env.example .env)
#   2. 修改其中的值
#   3. 启动时加载: Linux 用 `set -a; source .env; set +a; python app.py`
#                  或用 python-dotenv 自动加载
#
# 所有变量均有默认值, 不设置也能运行。

# ===== 服务器 =====
# 监听地址: 0.0.0.0=所有网卡(允许远程), 127.0.0.1=仅本机
HOST=0.0.0.0
# 监听端口
PORT=5000
# 调试模式 (生产环境务必设为 0)
DEBUG=0

# ===== 数据库 =====
# 不设置则使用默认 SQLite (qor_recorder.db)
# MySQL 示例:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/qor_recorder?charset=utf8mb4
# SQLite 示例:
# DATABASE_URL=sqlite:///qor_recorder.db

# ===== 安全 =====
# Flask 密钥 (生产环境务必修改, 可用 python -c "import secrets; print(secrets.token_hex(32))" 生成)
# 默认值仅允许 DEBUG=1 模式使用, 生产环境若仍是默认值将拒绝启动
SECRET_KEY=qor-recorder-dev-key-change-in-prod
# 是否强制检查 SECRET_KEY (1=强制, 0=关闭仅本地调试用)
ENFORCE_SECRET_KEY=1

# Session Cookie 安全
# SESSION_COOKIE_SECURE=1 仅 HTTPS 传输 (生产环境+反代 TLS 时开启)
SESSION_COOKIE_SECURE=0
# Session 有效期 (小时)
SESSION_LIFETIME_HOURS=12

# ===== 功能开关 =====
# 数据库可视化 (1=启用, 0=禁用)
ENABLE_DB_ADMIN=0
